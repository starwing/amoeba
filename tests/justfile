# amoeba test suite (C89, no external test framework).
#
# Normally driven from the repo root: `just check`, `just test dump`, `just cov`.
# This file can also be used directly:
#
#   just --justfile tests/justfile test dump          # one suite
#   just --justfile tests/justfile check              # everything, ASan
#
# Test sources live in tests/<suite>.c; misc/gen_entries.lua turns the
# TEST(name) functions into the entries table + main() (tests/<suite>.gen.inc,
# a build artifact: never edit or commit it).
#
# Every test runs in its own process, so an assert, a crash or a sanitizer hit
# fails only that one test and the rest still run.

set windows-shell := ["cmd.exe", "/C"]

ROOT  := source_directory() / ".."
SRC   := source_directory()
BUILD := source_directory() / "build"
GEN   := ROOT / "misc" / "gen_entries.lua"

CC  := env("CC", "cc")
CXX := env("CXX", "c++")
LUA := env("LUA", "lua")

# Lua binding: first existing pkg-config package wins; LUA_INC overrides both.
LUAJIT    := env("LUAJIT", "luajit")
LUA_PKG   := env("LUA_PKG", "lua5.5 lua5.4 lua5.3 lua")
LUAJIT_PKG := env("LUAJIT_PKG", "luajit")

WARN := "-Wall -Wextra -Werror -pedantic -Wno-variadic-macros"
INC  := "-I" + ROOT + " -I" + SRC
BASE := "-std=c89 " + WARN + " " + INC
SAN  := "-g -O0 -fsanitize=address,undefined -fno-sanitize-recover=undefined"

SUITES := "solver_test dump_test api_test"

default: check

# ---------------------------------------------------------------------------
# builds

# gen + compile every suite into build/<tag>/
[unix]
[private]
build tag flags suites=SUITES:
    #!/usr/bin/env bash
    set -euo pipefail
    out='{{BUILD}}/{{tag}}'
    mkdir -p "$out"
    for s in {{suites}}; do
        {{LUA}} '{{GEN}}' "{{SRC}}/$s.c" "{{SRC}}/$s.gen.inc" {{flags}}
        {{CC}} {{BASE}} {{SAN}} {{flags}} -o "$out/$s" "{{SRC}}/$s.c"
    done

# run every test of every suite, one process per test
[unix]
[private]
run tag flags="" suites=SUITES:
    #!/usr/bin/env bash
    set -uo pipefail
    failfile='{{BUILD}}/{{tag}}.failures'
    : > "$failfile"
    for s in {{suites}}; do
        bin='{{BUILD}}/{{tag}}/'"$s"
        echo "=== {{tag}}/$s ==="
        for t in $("$bin" --list); do
            if ! "$bin" "@$t"; then
                echo "*** FAILED: $s::$t" >&2
                echo "$s::$t" >> "$failfile"
            fi
        done
    done
    exit 0

# fail if any recorded test failed; `tags` is a space separated list
[unix]
[private]
verify tags:
    #!/usr/bin/env bash
    set -uo pipefail
    nfail=0
    for tag in {{tags}}; do
        f='{{BUILD}}/'"$tag"'.failures'
        [ -f "$f" ] || continue
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            echo "FAILED: $tag/$line" >&2
            nfail=$((nfail + 1))
        done < "$f"
    done
    if [ "$nfail" -ne 0 ]; then
        echo "" >&2
        echo "$nfail test(s) failed (see the FAIL lines above)" >&2
        exit 1
    fi
    echo "all suites passed"

# ---------------------------------------------------------------------------
# checks

# build + run every suite under ASan/UBSan
[unix]
check: (build "debug" "") (run "debug") (verify "debug")

# alias kept for muscle memory: sanitizers are the default
[unix]
check-asan: check

# -O2, no sanitizers: catches tests that only pass in a debug build
[unix]
check-release: (build "release" "-O2") (run "release") (verify "release")

# poison every automatic variable with 0xAA: a test (or library helper) that
# reads uninitialised memory behaves deterministically and fails here
[unix]
check-uninit: (build "uninit" "-O1 -ftrivial-auto-var-init=pattern") \
    (run "uninit") (verify "uninit")

# am_Num = double
[unix]
check-double: (build "double" "-DAM_USE_DOUBLE") (run "double") \
    (verify "double")

# one suite, one process per test: just test dump, just test dump roundtrip
[unix]
test name *args='':
    #!/usr/bin/env bash
    set -euo pipefail
    suite='{{name}}'
    case "$suite" in
        *_test) ;;
        *) suite="${suite}_test" ;;
    esac
    out='{{BUILD}}/debug'
    mkdir -p "$out"
    {{LUA}} '{{GEN}}' "{{SRC}}/$suite.c" "{{SRC}}/$suite.gen.inc"
    {{CC}} {{BASE}} {{SAN}} -o "$out/$suite" "{{SRC}}/$suite.c"
    exec "$out/$suite" {{args}}

# ---------------------------------------------------------------------------
# strict compile checks (no run)

# Clean C: the common subset of C89 and C++.  Compiles the suites and the
# header itself; -pedantic-errors makes any extension a failure.
[unix]
check-c89:
    #!/usr/bin/env bash
    set -uo pipefail
    fail=0
    for s in {{SUITES}}; do
        echo "--- c89 $s ---"
        {{LUA}} '{{GEN}}' "{{SRC}}/$s.c" "{{SRC}}/$s.gen.inc"
        {{CC}} -std=c89 -pedantic-errors {{WARN}} {{INC}} \
            -c -o /dev/null "{{SRC}}/$s.c" || fail=1
    done
    echo "--- c89 amoeba.h ---"
    mkdir -p '{{BUILD}}'
    printf '#define AM_IMPLEMENTATION\n#include "amoeba.h"\n' \
        > '{{BUILD}}/check_amoeba.c'
    {{CC}} -std=c89 -pedantic-errors {{WARN}} {{INC}} \
        -c -o /dev/null '{{BUILD}}/check_amoeba.c' || fail=1
    exit $fail

# C++03: amoeba.h is usable from C++, so the suites must build there too.
[unix]
check-cpp03:
    #!/usr/bin/env bash
    set -uo pipefail
    fail=0
    mkdir -p '{{BUILD}}'
    for s in {{SUITES}}; do
        echo "--- c++03 $s ---"
        {{LUA}} '{{GEN}}' "{{SRC}}/$s.c" "{{SRC}}/$s.gen.inc"
        {{CXX}} -x c++ -std=c++03 -pedantic-errors {{WARN}} {{INC}} \
            -c -o /dev/null "{{SRC}}/$s.c" || fail=1
    done
    exit $fail

# ---------------------------------------------------------------------------
# Lua binding: built from lua_amoeba.c, then test.lua drives it
#
# Every recipe picks the first existing pkg-config package; LUA_INC overrides
# the search.  Never fall back to the default include path: that silently
# builds against another Lua version.

# build build/lua/<tag>/amoeba.so
[unix]
[private]
lua-build tag pkgs flags="":
    #!/usr/bin/env bash
    set -euo pipefail
    out='{{BUILD}}/lua/{{tag}}'
    rm -rf "$out"
    mkdir -p "$out"
    inc=''
    for p in {{pkgs}}; do
        if pkg-config --exists "$p"; then inc="$(pkg-config --cflags "$p")"; break; fi
    done
    if [ -z "${LUA_INC:-}" ] && [ -z "$inc" ]; then
        echo "lua: no pkg-config for '{{pkgs}}'; set LUA_INC" >&2
        exit 1
    fi
    case "$(uname -s)" in
        Darwin) shlib='-bundle -undefined dynamic_lookup' ;;
        *)      shlib='-shared -fPIC' ;;
    esac
    {{CC}} -std=c99 -O2 {{flags}} $shlib ${LUA_INC:-$inc} -I'{{ROOT}}' \
        -o "$out/amoeba.so" '{{ROOT}}/lua_amoeba.c'
    # record the Lua ABI of these headers: a module built against another
    # version fails deep inside `require`, so lua-run checks it up front
    printf '%s\n' '#include <lua.h>' '#include <stdio.h>' \
        'int main(void) { printf("%d", LUA_VERSION_NUM); return 0; }' \
        > "$out/lua-version.c"
    {{CC}} ${LUA_INC:-$inc} -o "$out/lua-version" "$out/lua-version.c"
    "$out/lua-version" > "$out/lua-version-num"

[unix]
[private]
lua-run tag bin script=(ROOT / "test.lua"):
    #!/usr/bin/env bash
    set -euo pipefail
    out='{{BUILD}}/lua/{{tag}}'
    err="$out/stderr.txt"
    status=0
    # LUA/LUA_PKG are independent knobs; a mismatch only surfaces as a cryptic
    # `dlopen` failure, so reject it before running the suite
    want=$(cat "$out/lua-version-num" 2>/dev/null || echo '')
    if [ -n "$want" ]; then
        got=$('{{bin}}' -e 'io.write(_VERSION:match("%d+%.%d+"))') || {
            echo "lua: cannot run '{{bin}}'" >&2
            exit 1
        }
        wmaj=$((want / 100))
        wmin=$((want % 100))
        if [ "$wmaj.$wmin" != "$got" ]; then
            echo "lua: '{{bin}}' is Lua $got, but the module was built" \
                 "against Lua $wmaj.$wmin headers; set LUA and LUA_PKG" \
                 "(or LUAJIT and LUAJIT_PKG) together" >&2
            exit 1
        fi
    fi
    # a versioned LUA_CPATH_5_x wins over the plain one, so set them all
    LUA_CPATH="$out/?.so" \
        LUA_CPATH_5_5="$out/?.so" LUA_CPATH_5_4="$out/?.so" \
        LUA_CPATH_5_3="$out/?.so" LUA_CPATH_5_2="$out/?.so" \
        LUA_CPATH_5_1="$out/?.so" \
        {{bin}} '{{script}}' 2>"$err" || status=$?
    if [ "$status" -ne 0 ]; then
        cat "$err" >&2
        echo "lua binding test failed (exit $status)" >&2
        exit "$status"
    fi
    # test.lua is silent: a finalizer error or a warning means it failed
    if [ -s "$err" ]; then
        cat "$err" >&2
        echo "lua binding test wrote to stderr" >&2
        exit 1
    fi

[unix]
test-lua: (lua-build "lua" LUA_PKG) (lua-run "lua" LUA)

[unix]
test-lua-luajit: (lua-build "luajit" LUAJIT_PKG) (lua-run "luajit" LUAJIT)

[unix]
test-lua-double: (lua-build "double" LUA_PKG "-DAM_USE_DOUBLE") \
    (lua-run "double" LUA)

# line coverage of amoeba.h and lua_amoeba.c from one test.lua run
[unix]
cov-lua: (lua-build "cov" LUA_PKG "-O0 -g --coverage") (lua-run "cov" LUA)
    #!/usr/bin/env bash
    set -euo pipefail
    dir='{{BUILD}}/lua/cov'
    out='{{BUILD}}/cov-lua'
    rm -rf "$out"
    mkdir -p "$out"
    lcov --capture --directory "$dir" --rc branch_coverage=1 \
        --ignore-errors inconsistent,unsupported,empty,corrupt,gcov \
        --output-file "$out/lua.info"
    lcov --extract "$out/lua.info" '*/amoeba.h' '*/lua_amoeba.c' \
        --rc branch_coverage=1 --ignore-errors inconsistent,unused,corrupt \
        --output-file "$out/amoeba-lua.info"
    lcov --list "$out/amoeba-lua.info" --rc branch_coverage=1 \
        --ignore-errors inconsistent,corrupt
    # every zero-hit line, with its source text
    awk '/^SF:/{f=substr($0,4)} /^DA:/{split($0,a,","); if (a[2]=="0") print f "\t" substr(a[1],4)}' \
        "$out/amoeba-lua.info" | while IFS=$'\t' read -r f ln; do
        printf '%s:%s: %s\n' "$(basename "$f")" "$ln" "$(sed -n "${ln}p" "$f")"
    done

# ---------------------------------------------------------------------------
# coverage (lcov)

[unix]
cov:
    #!/usr/bin/env bash
    set -euo pipefail
    out='{{BUILD}}/cov'
    rm -rf "$out"
    mkdir -p "$out"
    for s in {{SUITES}}; do
        {{LUA}} '{{GEN}}' "{{SRC}}/$s.c" "{{SRC}}/$s.gen.inc"
        {{CC}} {{BASE}} -DNDEBUG -g -O0 --coverage -o "$out/$s" "{{SRC}}/$s.c"
        for t in $("$out/$s" --list); do
            ( cd "$out" && ./"$s" "@$t" >/dev/null 2>&1 ) || \
                echo "COV: $s::$t FAILED (coverage still collected)" >&2
        done
    done
    ( cd "$out" && lcov --capture --directory . --rc branch_coverage=1 \
        --ignore-errors inconsistent,unsupported,empty,corrupt \
        --output-file amoeba.info )
    lcov --extract '{{BUILD}}/cov/amoeba.info' '*/amoeba.h' \
        --rc branch_coverage=1 --ignore-errors inconsistent,unused,corrupt \
        --output-file '{{BUILD}}/amoeba.info'
    lcov --list '{{BUILD}}/amoeba.info' --rc branch_coverage=1 \
        --ignore-errors inconsistent,corrupt

# lines with zero coverage in amoeba.h
[unix]
uncovered:
    @awk '/^SF:/{z=($0 ~ /\/amoeba\.h$/)} z && /^DA:/ && /,0$/ {gsub(/DA:|,0/,""); print}' \
        '{{BUILD}}/amoeba.info' 2>/dev/null | sort -n | while read -r ln; do \
        src=$(sed -n "${ln}p" '{{ROOT}}/amoeba.h' 2>/dev/null); \
        echo "L$ln: $src"; \
    done

[unix]
clean-cov:
    rm -rf '{{BUILD}}/cov' '{{BUILD}}/cov-lua' '{{BUILD}}/lua/cov'
    rm -f '{{BUILD}}'/*.info

# ---------------------------------------------------------------------------
# cleanup

[unix]
clean:
    rm -rf '{{BUILD}}'
    rm -f '{{SRC}}'/*.gen.inc

[windows]
check:
    @echo "the test recipes need a POSIX shell; see TODO.md (MSVC port)" && exit /b 2

[windows]
clean:
    @if exist "{{BUILD}}" rmdir /s /q "{{BUILD}}"
    @if exist "{{SRC}}\*.gen.inc" del /q "{{SRC}}\*.gen.inc"
